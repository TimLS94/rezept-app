{
  "expo": {
    "name": "SpoonDrop",
    "slug": "spoondrop",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spoondrop.app",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:spoondrop.app"
      ],
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "instagram",
          "instagram-stories",
          "instacart",
          "walmart"
        ]
      }
    },
    "android": {
      "package": "com.spoondrop.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#141414",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "*.instagram.com",
              "pathPrefix": "/reel"
            },
            {
              "scheme": "https",
              "host": "*.instagram.com",
              "pathPrefix": "/p"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SpoonDrop to access your photos to upload recipe and profile images.",
          "cameraPermission": "Allow SpoonDrop to use your camera to scan your fridge for recipe ideas."
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-audio",
      "expo-apple-authentication",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "androidIntentFilters": ["text/*"]
        }
      ]
    ],
    "scheme": "spoondrop",
    "newArchEnabled": true
  }
}
