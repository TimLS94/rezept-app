{
  "expo": {
    "name": "FeedFamily",
    "slug": "feedfamily",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.feedfamily.app",
      "buildNumber": "1",
      "associatedDomains": ["applinks:feedfamily.app"],
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["instagram", "instagram-stories", "instacart", "walmart"]
      }
    },
    "android": {
      "package": "com.feedfamily.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FF6B35",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "*.instagram.com",
              "pathPrefix": "/reel"
            },
            {
              "scheme": "https",
              "host": "*.instagram.com",
              "pathPrefix": "/p"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "SEND",
          "category": ["DEFAULT"],
          "data": [
            { "mimeType": "text/plain" }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FeedFamily to access your photos to upload recipe and profile images."
        }
      ],
      "expo-secure-store"
    ],
    "scheme": "feedfamily",
    "newArchEnabled": true
  }
}
