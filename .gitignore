# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
.env
# Every variant, not just the exact name. A `.env.bak` written while rotating
# keys was not matched by `.env`, went into a commit, and was stopped by
# GitHub's push protection — which is not a control to rely on twice.
.env.*
!.env.example
dist/

# Supabase CLI local state
supabase/.temp/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
